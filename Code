import pandas as pd
df = pd.read_csv("product_sales_dataset.csv")
print("Original Dataset:")
print(df)
df["Total"] = df["Quantity"] * df["Price"]
print("\nDataset with Total Column:")
print(df)
print("\nProducts with Price greater than 3000:")
print(df[df["Price"] > 3000])
print("\nSorted by Total Amount:")
print(df.sort_values(by="Total", ascending=False))
print("\nCategory-wise Total Sales:")
print(df.groupby("Category")["Total"].sum())
